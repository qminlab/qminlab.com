"주변 몬스터에게 무적 부여"],["패턴","검은 불꽃 3발 발사"],["반응","공격받으면 불꽃을 다른 촛대로 옮김"],["생김새","검은 불꽃의 촛대"]]},"biome5/whispering_shadow":{"l":[["체력","3타 · 희귀"],["패턴","투명하게 다가와 뒤에서 할퀴기"],["패턴","속삭임으로 화면 가장자리를 흐리게 함"],["반응","랜턴 빛 안에서만 보이고, 들키면 도망"],["생김새","길쭉한 그림자 인간"]]},"biome5/void_executioner":{"l":[["체력","12타 · 영웅"],["패턴","바닥에 예고 선을 그린 뒤 방 절반 낫 쓸기"],["패턴","낫 투척, 원을 그리며 돌아옴"],["패턴","순간이동 후 내리찍기"],["반응","거리가 멀면 순간이동으로 따라붙음"],["빈틈","낫 쓸기 직후 2초"],["생김새","거대한 낫, 얼굴 없는 두건"]]},"biome5/memory_eater":{"l":[["체력","10타 · 영웅"],["패턴","촉수 4개를 순서대로 내리찍기"],["패턴","화면 일부를 3초간 지우는 교란"],["패턴","촉수로 플레이어를 붙잡아 끌어당김"],["반응","맞으면 촉수로 몸을 감싸 1초 방어"],["빈틈","교란 중에는 본체가 무방비"],["생김새","뇌 모양 몸, 수많은 촉수"]]},"biome1/spider_king":{"l":[["체력","1타 · 일반"]]},"biome1/crow_flock":{"l":[["체력","1타 · 희귀"],["패턴","원을 그리다 한 마리씩 급강하"],["패턴","2마리 이하가 되면 X자 교차 동시 급강하"],["반응","맞으면 흩어졌다 다시 모임"],["생김새","깃털 빠진 검은 까마귀"]]},"biome1/tombstone_mimic_disguise":{"l":[["체력","5타 · 희귀"],["패턴","깨어나며 내리찍기 충격파"],["패턴","뛰어서 추격하다 멈춰 이빨 3연속 물기"],["반응","체력 2타 이하면 다시 비석으로 위장"],["생김새","이빨 달린 이끼 낀 비석"]]},"boss:spider_king":{"l":[["생김새","등에 묘비를 짊어진 거대 거미"],["1페이즈 (40~25타)","① 앞다리를 들어올린 뒤 2연속 찍기 ② 거미줄 발사, 맞은 바닥에 3초간 감속 장판 ③ 알이 갈라지는 예고 후 새끼 거미 3마리 소환 (최대 6마리)"],["2페이즈 (24~12타)","천장으로 올라감. ④ 그림자가 1.2초 따라오다 멈추고 0.6초 뒤 낙하, 착지 충격파 ⑤ 천장에서 독액 비, 붉은 원 위치에 차례로 떨어짐"],["3페이즈 (11~0타)","등의 묘비가 깨지며 광폭화. ⑥ 기둥 사이에 거미줄 벽을 쳐서 방을 좁힘 ⑦ 방을 가로질러 3번 회전 돌진, 벽에 튕김. 모든 패턴 공격 속도 +20%"],["대응","등 뒤에 3초 이상 있으면 뒷다리 걷어차기로 밀어냄"],["빈틈","④ 낙하 후 2초간 뒤집힘, ⑦ 돌진이 끝난 뒤 1.5초 어지러움"],["2페이즈 공략","천장에 있는 동안은 공격할 수 없어요. 낙하를 유도해야 해요."]]},"boss:endless_furnace":{"l":[["생김새","얼굴 모양 화구를 가진 용광로"],["1페이즈 (50~34타)","① 쇳물 국자가 붉은 원 3곳에 차례로 투하 ② 화구가 밝아진 뒤 불꽃 부채꼴 ③ 경고등이 깜빡인 뒤 컨베이어 방향 전환"],["2페이즈 (33~17타)","④ 컨베이어를 따라 쇳덩이가 굴러옴 ⑤ 좌우 벽에서 증기 분사, 중앙 한 줄만 안전"],["3페이즈 (16~0타)","바닥 일부가 쇳물로 녹아 밟을 수 있는 칸이 줄어듦. ⑥ 과열: 5초간 쇳물 연속 투하, 끝나면 화구가 3초간 크게 열림"],["약점 구조","페이즈마다 방 아래쪽에 냉각 밸브 3개가 나와요. 3개를 모두 부수면 화구가 5초 열리고, 이때만 본체에 피해가 들어가요."],["빈틈","화구 열림, 3페이즈 과열 직후"],["대응","밸브 근처에 오래 있으면 그 줄의 컨베이어를 반대로 돌려 밀어냄"]]},"boss:drowned_king":{"l":[["생김새","녹슨 왕관, 물이 흐르는 망토"],["1페이즈 (60~41타)","발목 (이동 감소 없음) / ① 삼지창 3연속 찌르기 ② 삼지창을 던졌다가 손짓으로 회수, 돌아올 때도 판정 ③ 원형 물결 파동 2겹, 구르기로 통과"],["2페이즈 (40~21타)","바닥 절반이 깊은 물 / ④ 물속으로 잠수, 플레이어 아래에 물결이 모인 뒤 솟구침 ⑤ 익사자 2마리 소환"],["3페이즈 (20~0타)","발판 4개만 남음 / ⑥ 왕관이 빛나며 발판을 하나씩 가라앉혔다 다시 올림 ⑦ 방 중앙 소용돌이로 3초간 끌어당김"],["대응","2페이즈부터 플레이어가 멀리 있으면 잠수해서 거리를 좁힘"],["빈틈","② 삼지창이 없는 동안, ④ 솟구친 뒤 1.5초"],["페이즈 전환","왕이 옥좌를 내리치며 수위 상승. 깊은 물에 서 있던 플레이어는 가장 가까운 발판으로 밀려남 (피해 없음)"]]},"boss:sleeping_dragon":{"l":[["생김새","광석이 뒤덮인 늙은 용"],["0 (수면)페이즈 (—)","공격하지 않음. 구르기·철판 소리를 내면 깨어남. 걸어서 몰래 다가가 첫 공격을 하면 3초 기절"],["1페이즈 (70~47타)","① 꼬리 쓸기, 뒤쪽 반원 ② 앞발 찍기, 광석 파편이 튐 ③ 숨을 들이쉬는 예고 후 방 한쪽에서 반대쪽으로 브레스 쓸기, 기둥 뒤만 안전"],["2페이즈 (46~24타)","날아오름. ④ 공중에서 화염탄 3연사 ⑤ 착지 충격파, 가장 가까운 기둥 1개 파괴"],["3페이즈 (23~0타)","⑥ 바닥 균열에서 용암 기둥이 순서대로 분출 ⑦ 방 전체 브레스, 남은 기둥 뒤만 안전"],["기둥 규칙","3페이즈 시작 때 남은 기둥이 2개 미만이면 2개까지 다시 솟아오른다 (못 깨는 상황 방지)"],["대응","정면에서 오래 공격하면 날개로 몸을 가리고 1초 방어"],["빈틈","② 앞발 찍기 후 머리가 내려옴, ⑤ 착지 후 2초"],["광폭화","체력 10타 이하에서 브레스 예고 시간 −30% (최소 0.25초 규칙은 유지)"]]},"boss:lantern_swallower":{"l":[["생김새","배 속에서 랜턴 빛이 새어 나오는 거인"],["1페이즈 (80~54타)","방의 모든 빛이 꺼짐. ① 거대한 손 내려치기, 낮은 울림 소리와 바닥의 붉은 균열로 예고 ② 3초간 플레이어 랜턴 시야를 절반으로 빨아들임 ③ 그림자 손 4마리 소환"],["2페이즈 (53~27타)","④ 배 속 빛을 레이저처럼 쏘며 한 바퀴 회전 ⑤ 어둠 속으로 사라졌다가 다른 위치에서 나타나 내려치기"],["3페이즈 (26~0타)","⑥ 플레이어의 랜턴을 삼킴: 10초간 플레이어 시야가 0이 되고 보스 배 속 빛만 보임 ⑦ 메아리 3마리 소환"],["무적 구조","보스는 평소 무적. 빛 기둥 1개를 켜면 (기둥 앞에서 E 키 2초) 8초간 피해가 들어가고, 기둥은 다시 꺼져요. 같은 기둥은 20초 뒤 다시 켤 수 있어요."],["대응","플레이어가 빛 기둥을 켜는 중이면 그 기둥 쪽으로 손 내려치기를 우선 사용"],["빈틈","④ 레이저 회전이 끝난 뒤 2초"],["3페이즈 공략","랜턴이 꺼진 10초 동안은 소리 예고와 보스 배 속 빛만으로 피해야 해요. 10초 뒤 랜턴이 돌아와요."]]},"traps/spike_floor":{"l":[["요약","일정 주기로 솟음"],["동작","바닥 틈이 먼저 빛나고(예고) 가시가 솟아 피격."]]},"traps/arrow_launcher":{"l":[["요약","벽에 붙어 복도 쪽으로 직선 발사 (벽 칸에 놓기)"],["동작","벽 칸에 붙어 바라보는 복도 쪽으로 화살을 직선 발사."]]},"traps/spinning_blade":{"l":[["요약","바닥 레일 2~6칸을 왕복 (3칸까지 마력 1, 4~6칸 2)"],["동작","바닥 레일 위를 칼날이 왕복. 레일 3칸까지 마력 1, 4~6칸은 2."]]},"traps/crusher_wall":{"l":[["요약","양쪽 벽이 닫힘 (방향=닫히는 축)"],["동작","가운데 칸 양쪽 벽이 닫혀 1.2초 끼임 피격 후 열림. 주기 약 4초, 닫히기 0.6초 전 먼지 예고. 채널이 있으면 켜질 때 1회."]]},"traps/flame_vent":{"l":[["요약","주기적으로 불기둥"],["동작","분사구에서 한 방향 3칸 직선 불기둥 1초. 주기 3초, 분사 0.7초 전 붉게 달아오름."]]},"traps/poison_pool":{"l":[["요약","밟으면 가스 확산"],["동작","밟고 0.5초 뒤 반경 2.5칸 가스 구름 4초. 구름 안에 있는 동안 계속 피격. 구르기로 지나가면 안 터짐."]]},"traps/bind_trap":{"l":[["요약","밟으면 1초 묶임"],["동작","밟으면 1초 동안 묶임. 한 번 쓰고 3초 뒤 다시 장전."]]},"traps/rolling_boulder":{"l":[["요약","압력판/레버로 작동"],["동작","연결된 압력판·레버가 켜지는 순간 천장이 흔들리고(0.5초) 벽까지 굴러가며 관통 피격. 꺼지면 제자리로."]]},"traps/explosive_barrel":{"l":[["요약","공격하면 폭발, 적도 피해"],["동작","베면 0.4초 뒤 반경 2칸 폭발 — 플레이어도 맞고, 반경 안 몬스터도 큰 피해."]]},"traps/wind_hole":{"l":[["요약","랜턴을 잠시 꺼뜨림"],["동작","5초마다 반경 2.5칸 바람 분출, 안에 있으면 랜턴이 1.5초 꺼짐. 0.7초 전 바람 소리 예고."]]},"traps/trap_chest":{"l":[["요약","열면 가시 폭발"],["동작","열면 사방 반경 2칸에 가시가 솟음(0.3초 뒤 피격). 자물쇠 색이 미세하게 다름."]]},"devices/torch":{"l":[["요약","벽 앞면의 고정 광원 (벽 칸에 놓기)"],["동작","항상 켜진 고정 광원(반경 약 4.5칸). 규칙상 효과는 없음."]]},"devices/pressure_plate":{"l":[["요약","밟으면 같은 번호가 작동"],["동작","플레이어나 몬스터가 서 있는 동안 연결된 함정·문이 켜짐."]]},"devices/lever_off":{"l":[["요약","공격하면 같은 번호가 개폐"],["동작","공격할 때마다 켜짐·꺼짐이 바뀜."]]},"devices/lever_on":{"l":[["요약","공격하면 같은 번호가 개폐"],["동작","공격할 때마다 켜짐·꺼짐이 바뀜."]]},"devices/sealed_door":{"l":[["요약","방 안 몬스터를 모두 잡아야 열림 (방향=지키는 방 쪽)"],["동작","지키는 방의 몬스터가 모두 쓰러지면 열림."],["같은 그림","레버·압력판으로 여닫는 일반 문(같은 번호가 켜지면 열림)"]]},"devices/teleport_rune":{"l":[["요약","같은 번호 두 개가 짝"],["동작","같은 번호 룬 둘이 짝. 올라서면 반대쪽 룬으로 이동, 양쪽 1.5초 쿨다운."]]},"items/moss_stone":{"l":[["얻는 곳","몬스터 처치·상자"],["쓰임","판매 불가 — 곡괭이 강화, 내 던전 층·마력 확장, 꾸미기 염색"]]},"items/bone":{"l":[["얻는 곳","이끼 묘지의 몬스터·상자"],["쓰임","블록 제작, 내 던전 업그레이드"]]},"items/gear":{"l":[["얻는 곳","녹슨 공방의 몬스터·상자"],["쓰임","블록 제작, 내 던전 업그레이드"]]},"items/pearl":{"l":[["얻는 곳","가라앉은 신전의 몬스터·상자"],["쓰임","블록 제작, 내 던전 업그레이드"]]},"items/obsidian":{"l":[["얻는 곳","용암 광맥의 몬스터·상자"],["쓰임","블록 제작, 내 던전 업그레이드"]]},"items/void_stone":{"l":[["얻는 곳","칠흑 심연의 몬스터·상자"],["쓰임","블록 제작, 내 던전 업그레이드"]]},"items/soul_flame":{"l":[["얻는 곳","몬스터 처치, 혼불 제단, 보물 상자"],["쓰임","몬스터 소환"]]},"items/monster_shard":{"l":[["얻는 곳","그 몬스터를 처치"],["쓰임","파편을 모아 확정 소환"]]},"items/lantern_oil":{"l":[["얻는 곳","기름 샘, 상자, 역청 조각 3개, 30분마다 저절로 1병(5병까지)"],["쓰임","원정 입장"]]},"items/healing_potion":{"l":[["얻는 곳","상자, 층 클리어"],["쓰임","원정 중 체력 1칸 회복"]]},"items/trap_blueprint":{"l":[["얻는 곳","상자, 보물 창고 상자"],["쓰임","내 던전에 새 함정 설치"]]},"items/bitumen_chunk":{"l":[["얻는 곳","폐광산 (위 갱도에 많고 깊은 갱도에도 조금)"],["쓰임","5개 = 랜턴 기름 1병 (기름이 가득이면 창고에 보관) · 제련소에서 광석을 녹이는 땔감"]]},"devices/sealed_box":{"l":[["얻는 곳","1~4층의 일반 상자"],["쓰임","마을에서 열어 혼불과 파편을 얻음"]]},"mine/block_ore_iron":{"l":[["캐면","철광석"],["얻는 곳","폐광산 깊은 갱도 (흔함)"],["쓰임","그대로는 못 팔아요 — 제련소에서 3개 + 역청 1 → 철괴"]]},"mine/block_ore_iron_glint":{"l":[["그림","빛이 닿을 때 반짝이는 프레임"],["캐면","철광석"],["얻는 곳","폐광산 깊은 갱도 (흔함)"],["쓰임","그대로는 못 팔아요 — 제련소에서 3개 + 역청 1 → 철괴"]]},"mine/block_ore_silver":{"l":[["캐면","은광석"],["얻는 곳","폐광산 깊은 갱도 (가끔)"],["쓰임","제련소에서 3개 + 역청 1 → 은괴 (그대로는 못 팔아요)"]]},"mine/block_ore_silver_glint":{"l":[["그림","빛이 닿을 때 반짝이는 프레임"],["캐면","은광석"],["얻는 곳","폐광산 깊은 갱도 (가끔)"],["쓰임","제련소에서 3개 + 역청 1 → 은괴 (그대로는 못 팔아요)"]]},"mine/block_ore_gold":{"l":[["캐면","금광석"],["얻는 곳","폐광산 깊은 갱도 (드묾)"],["쓰임","거래소에 팔거나 제련소에서 3개 + 역청 1 → 금괴"]]},"mine/block_ore_gold_glint":{"l":[["그림","빛이 닿을 때 반짝이는 프레임"],["캐면","금광석"],["얻는 곳","폐광산 깊은 갱도 (드묾)"],["쓰임","거래소에 팔거나 제련소에서 3개 + 역청 1 → 금괴"]]},"mine/block_ore_abyss_crystal":{"l":[["캐면","심연 수정"],["얻는 곳","폐광산 깊은 갱도 (아주 드묾)"],["쓰임","거래소에 팔아 은전으로"]]},"mine/block_ore_abyss_crystal_glint":{"l":[["그림","빛이 닿을 때 반짝이는 프레임"],["캐면","심연 수정"],["얻는 곳","폐광산 깊은 갱도 (아주 드묾)"],["쓰임","거래소에 팔아 은전으로"]]},"mine/block_rubble_vein":{"l":[["캐면","돌 조각"],["얻는 곳","폐광산에서 평범한 돌을 캘 때"],["쓰임","판매 불가 — 내 던전 지형 블록(벽 5 · 기둥 10 · 그 밖 5)을 놓는 데 써요"]]},"mine/block_bitumen":{"l":[["캐면","역청 조각"],["쓰임","5개 = 랜턴 기름 1병 (기름이 가득이면 창고에 보관) · 제련소에서 광석을 녹이는 땔감"]]},"relics/worn_boots":{"l":[["분류","이동 · 평범 (1점)"],["효과","구르기 쿨다운 0.2 → 0.15초"]],"n":"닳은 장화"},"relics/singed_lace":{"l":[["분류","이동 · 평범 (1점)"],["효과","구르기 직후 0.3초간 이동 속도 +15%"]],"n":"그을린 끈"},"relics/callus_gloves":{"l":[["분류","방어 · 평범 (1점)"],["효과","피격 후 무적 1.0